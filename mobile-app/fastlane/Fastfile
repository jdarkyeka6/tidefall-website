require "fileutils"
require "shellwords"

APP_IDENTIFIER = "au.com.tidefall.app"
PROJECT_PATH = "ios/Tidefall.xcodeproj"
WORKSPACE_PATH = "ios/Tidefall.xcworkspace"
SCHEME = "Tidefall"

default_platform(:ios)

platform :ios do
  desc "Build Tidefall and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text = if raw.include?("BEGIN PRIVATE KEY")
      raw
    else
      begin
        require "base64"
        Base64.decode64(raw)
      rescue StandardError
        raw
      end
    end

    unless key_text.include?("BEGIN PRIVATE KEY")
      UI.user_error!("ASC_KEY_CONTENT must be a .p8 private key or base64 of one.")
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text)
    File.chmod(0600, key_path)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # Do not create a local Apple Distribution certificate on the ephemeral
    # GitHub runner. Apple's cloud-managed distribution signing can be used by
    # xcodebuild when an App Store Connect API key is supplied.
    update_code_signing_settings(
      path: PROJECT_PATH,
      use_automatic_signing: true,
      team_id: team_id,
      targets: [SCHEME]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )

    increment_build_number(
      xcodeproj: PROJECT_PATH,
      build_number: latest + 1
    )

    build_root = File.expand_path("../build", __dir__)
    archive_path = File.join(build_root, "Tidefall.xcarchive")
    export_path = File.join(build_root, "export")
    export_plist = File.join(build_root, "ExportOptions.plist")

    FileUtils.rm_rf(build_root)
    FileUtils.mkdir_p(export_path)

    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>destination</key>
        <string>export</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>teamID</key>
        <string>#{team_id}</string>
        <key>manageAppVersionAndBuildNumber</key>
        <false/>
      </dict>
      </plist>
    PLIST

    auth_flags = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{Shellwords.escape(key_path)}",
      "-authenticationKeyID #{Shellwords.escape(key_id)}",
      "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}"
    ].join(" ")

    archive_cmd = [
      "xcodebuild",
      "-workspace #{Shellwords.escape(WORKSPACE_PATH)}",
      "-scheme #{Shellwords.escape(SCHEME)}",
      "-configuration Release",
      "-destination 'generic/platform=iOS'",
      "-archivePath #{Shellwords.escape(archive_path)}",
      "DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}",
      "CODE_SIGN_STYLE=Automatic",
      auth_flags,
      "archive"
    ].join(" ")

    sh(archive_cmd)

    export_cmd = [
      "xcodebuild -exportArchive",
      "-archivePath #{Shellwords.escape(archive_path)}",
      "-exportPath #{Shellwords.escape(export_path)}",
      "-exportOptionsPlist #{Shellwords.escape(export_plist)}",
      auth_flags
    ].join(" ")

    sh(export_cmd)

    ipa_path = Dir[File.join(export_path, "*.ipa")].first
    UI.user_error!("No IPA was produced by Xcode export") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
